ARG VERSION=1.37.4
ARG RUST_VERSION=1.99.0
ARG WEB_VAULT_VERSION=v2026.7.0

PKG ca_root_nss git gmake pkgconf perl5 postgresql17-client curl
CMD mkdir -p /usr/local/bin /usr/local/libexec /usr/local/cargo /usr/local/rustup /app /tmp/makebin /root/cargo
CMD ln -sf /usr/local/bin/gmake /tmp/makebin/make

CMD fetch -o /tmp/rustup-init.sh https://sh.rustup.rs
CMD env CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain ${RUST_VERSION} --component rustfmt,clippy
CMD ln -sf /usr/local/cargo/bin/* /usr/local/bin/

CP build-vaultwarden.sh /usr/local/libexec/build-vaultwarden.sh
CP build-web-vault.sh /usr/local/libexec/build-web-vault.sh
CMD /usr/local/libexec/build-vaultwarden.sh ${VERSION}
CMD /usr/local/libexec/build-web-vault.sh ${WEB_VAULT_VERSION}
