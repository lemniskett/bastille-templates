ARG GO_VERSION=1.27.1
ARG VERSION=v0.40.4

PKG ca_root_nss
CMD mkdir -p /usr/local/bin

CMD fetch -o /tmp/go.tar.gz https://go.dev/dl/go${GO_VERSION}.freebsd-amd64.tar.gz
CMD tar -xzf /tmp/go.tar.gz -C /usr/local
CMD ln -sf /usr/local/go/bin/* /usr/local/bin/

CMD env CGO_ENABLED=0 GOBIN=/app go install -ldflags "-s -w" github.com/pocketbase/pocketbase/examples/base@${VERSION}
CMD mv /app/base /app/pocketbase
