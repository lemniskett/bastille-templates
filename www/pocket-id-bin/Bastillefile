ARG VERSION=2.18.0
ARG APP_UID=8410
ARG APP_SHELL=/usr/sbin/nologin

PKG ca_root_nss
CMD mkdir -p /usr/local/bin
CMD pw groupadd -n app -g ${APP_UID}
CMD pw useradd -n app -u ${APP_UID} -g app -d /data -s ${APP_SHELL}
CP rc.d/app /usr/local/etc/rc.d/app
CP entrypoint.sh /entrypoint.sh

CMD fetch -o /usr/local/bin/pocket-id https://github.com/pocket-id/pocket-id/releases/download/v${VERSION}/pocket-id_freebsd_amd64
CMD chmod 755 /usr/local/bin/pocket-id

SYSRC app_enable=YES
SERVICE app start
